@model eParty.Areas.Admin.Models.ApiGatewayLogListViewModel
@using System.Linq

@{
    ViewBag.Title = "API Gateway Logs";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="page-header">
    <h3 class="fw-bold mb-3">API Gateway Security Logs</h3>
    <ul class="breadcrumbs mb-3">
        <li class="nav-home">
            <a href="/Admin/Dashboard">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Security</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">API Gateway Logs</a>
        </li>
    </ul>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card">
    <div class="card-header">
        <div class="card-title">Log Maintenance</div>
    </div>

    <div class="card-body">
        <div class="d-flex gap-2">
            @using (Html.BeginForm(
                "DeleteOldLogs",
                "ApiGatewayLogs",
                new { area = "Admin" },
                FormMethod.Post,
                new { style = "display:inline;" }
            ))
            {
                @Html.AntiForgeryToken()

                <input type="hidden" name="days" value="7" />

                <button type="submit"
                        class="btn btn-warning btn-sm"
                        onclick="return confirm('Xóa log cũ hơn 7 ngày?');">
                    Delete Logs Older Than 7 Days
                </button>
            }

            @using (Html.BeginForm(
                "DeleteAllLogs",
                "ApiGatewayLogs",
                new { area = "Admin" },
                FormMethod.Post,
                new { style = "display:inline; margin-left: 8px;" }
            ))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger btn-sm"
                        onclick="return confirm('Bạn chắc chắn muốn xóa TOÀN BỘ API Gateway logs?');">
                    Delete All Logs
                </button>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="numbers">
                    <p class="card-category">Total Logs</p>
                    <h4 class="card-title">@Model.TotalLogs</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="numbers">
                    <p class="card-category">Filtered Logs</p>
                    <h4 class="card-title">@Model.FilteredLogs</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="numbers">
                    <p class="card-category">Monitor</p>
                    <h4 class="card-title text-warning">@Model.MonitorCount</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-3">
        <div class="card card-stats card-round">
            <div class="card-body">
                <div class="numbers">
                    <p class="card-category">Rate Limited</p>
                    <h4 class="card-title text-danger">@Model.ChallengeCount</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="card-title">Filter Logs</div>
    </div>
    <div class="card-body">
        <form method="get" action="/Admin/ApiGatewayLogs">
            <div class="row">
                <div class="col-md-2 mb-3">
                    <label>IP Address</label>
                    <input type="text"
                           name="ipAddress"
                           class="form-control"
                           value="@Model.IpAddress"
                           placeholder="::1 / 127.0.0.1" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>Final Action</label>
                    <select name="finalAction" class="form-control">
                        <option value="">All</option>
                        <option value="allow" @(Model.FinalAction == "allow" ? "selected" : "")>allow</option>
                        <option value="monitor" @(Model.FinalAction == "monitor" ? "selected" : "")>monitor</option>
                        <option value="challenge_or_rate_limit" @(Model.FinalAction == "challenge_or_rate_limit" ? "selected" : "")>challenge_or_rate_limit</option>
                        <option value="block" @(Model.FinalAction == "block" ? "selected" : "")>block</option>
                    </select>
                </div>

                <div class="col-md-2 mb-3">
                    <label>Predicted Label</label>
                    <select name="predictedLabel" class="form-control">
                        <option value="">All</option>
                        <option value="normal" @(Model.PredictedLabel == "normal" ? "selected" : "")>normal</option>
                        <option value="abnormal" @(Model.PredictedLabel == "abnormal" ? "selected" : "")>abnormal</option>
                    </select>
                </div>

                <div class="col-md-2 mb-3">
                    <label>Decision Source</label>
                    <input type="text"
                           name="decisionSource"
                           class="form-control"
                           value="@Model.DecisionSource"
                           placeholder="ml_monitor / rule_rate_limit" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>From Date</label>
                    <input type="date"
                           name="fromDate"
                           class="form-control"
                           value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" />
                </div>

                <div class="col-md-2 mb-3">
                    <label>To Date</label>
                    <input type="date"
                           name="toDate"
                           class="form-control"
                           value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Search
                </button>

                <a href="/Admin/ApiGatewayLogs" class="btn btn-secondary">
                    Reset
                </a>

                <a class="btn btn-success"
                   href="@Url.Action("ExportCsv", "ApiGatewayLogs", new {
                        area = "Admin",
                        ipAddress = Model.IpAddress,
                        finalAction = Model.FinalAction,
                        predictedLabel = Model.PredictedLabel,
                        decisionSource = Model.DecisionSource,
                        fromDate = Model.FromDate,
                        toDate = Model.ToDate
                   })">
                    <i class="fas fa-file-csv"></i> Export CSV
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="card-title">API Gateway Logs</div>
    </div>

    <div class="card-body">
        @if (Model.Logs == null || !Model.Logs.Any())
        {
            <div class="alert alert-info">
                Không có log phù hợp.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>IP</th>
                            <th>Route</th>
                            <th>Risk</th>
                            <th>Label</th>
                            <th>Action</th>
                            <th>Source</th>
                            <th>Rate/min</th>
                            <th>Seq</th>
                            <th>Loops</th>
                            <th>Created At</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Logs)
                        {
                            string actionClass = "badge-secondary";

                            if (item.FinalAction == "allow")
                            {
                                actionClass = "badge-success";
                            }
                            else if (item.FinalAction == "monitor")
                            {
                                actionClass = "badge-warning";
                            }
                            else if (item.FinalAction == "challenge_or_rate_limit")
                            {
                                actionClass = "badge-danger";
                            }
                            else if (item.FinalAction == "block")
                            {
                                actionClass = "badge-danger";
                            }

                            string riskClass = "text-success";

                            if (item.RiskScore >= 0.95)
                            {
                                riskClass = "text-danger fw-bold";
                            }
                            else if (item.RiskScore >= 0.80)
                            {
                                riskClass = "text-warning fw-bold";
                            }

                            <tr>
                                <td>@item.Id</td>
                                <td>@item.IpAddress</td>
                                <td>
                                    <strong>@item.Controller</strong>/<span>@item.ActionName</span>
                                </td>
                                <td class="@riskClass">
                                    @item.RiskScore.ToString("0.0000")
                                </td>
                                <td>
                                    @if (item.PredictedLabel == "abnormal")
                                    {
                                        <span class="badge badge-danger">abnormal</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">normal</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @actionClass">
                                        @item.FinalAction
                                    </span>
                                </td>
                                <td>@item.DecisionSource</td>
                                <td>@item.RequestRatePerMin.ToString("0.##")</td>
                                <td>@item.SequenceLength.ToString("0.##")</td>
                                <td>@item.GraphSelfLoops.ToString("0.##")</td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    <a class="btn btn-sm btn-info"
                                       href="@Url.Action("Details", "ApiGatewayLogs", new { area = "Admin", id = item.Id })">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav>
                <ul class="pagination">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "ApiGatewayLogs", new {
                                area = "Admin",
                                page = Model.Page - 1,
                                pageSize = Model.PageSize,
                                ipAddress = Model.IpAddress,
                                finalAction = Model.FinalAction,
                                predictedLabel = Model.PredictedLabel,
                                decisionSource = Model.DecisionSource,
                                fromDate = Model.FromDate,
                                toDate = Model.ToDate
                           })">
                            Previous
                        </a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">
                            Page @Model.Page / @Model.TotalPages
                        </span>
                    </li>

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "ApiGatewayLogs", new {
                                area = "Admin",
                                page = Model.Page + 1,
                                pageSize = Model.PageSize,
                                ipAddress = Model.IpAddress,
                                finalAction = Model.FinalAction,
                                predictedLabel = Model.PredictedLabel,
                                decisionSource = Model.DecisionSource,
                                fromDate = Model.FromDate,
                                toDate = Model.ToDate
                           })">
                            Next
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>