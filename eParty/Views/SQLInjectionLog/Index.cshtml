@model IEnumerable<eParty.Models.SQLInjectionLog>

@{
    ViewBag.Title = "SQL Injection Logs";
}

<h2>🔍 SQL Injection Detection Logs</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- NÚT LỌC THAY VÌ TÌM KIẾM -->
<div class="btn-group" style="margin-bottom:15px;">
    <a href="@Url.Action("Index")" class="btn btn-default @(ViewBag.CurrentFilter == "all" ? "active" : "")">Tất cả</a>
    <a href="@Url.Action("Index", new { filter = "rule" })" class="btn btn-default @(ViewBag.CurrentFilter == "rule" ? "active" : "")">Rule-based</a>
    <a href="@Url.Action("Index", new { filter = "ml" })" class="btn btn-default @(ViewBag.CurrentFilter == "ml" ? "active" : "")">ML Model</a>
    <a href="@Url.Action("Index", new { filter = "blocked" })" class="btn btn-default @(ViewBag.CurrentFilter == "blocked" ? "active" : "")">Đã chặn</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th style="width:140px;">Thời gian</th>
            <th style="width:110px;">IP Address</th>
            <th style="width:180px;">URL</th>
            <th>Payload</th>
            <th style="width:130px;">Phát hiện bởi</th>
            <th style="width:100px;">Xác suất</th>
            <th style="width:90px;">Trạng thái</th>
            <th style="width:140px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td><strong>@log.IpAddress</strong></td>
                <td style="font-size:13px;">@log.Url</td>
                <td style="max-width:420px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-family:Consolas; font-size:13px;">
                    <span title="@log.SuspiciousInput" style="cursor:help;">
                        @if (log.SuspiciousInput.Length > 80)
                        {
                            @(log.SuspiciousInput.Substring(0, 77) + "...")
                        }
                        else
                        {
                            @log.SuspiciousInput
                        }
                    </span>
                </td>
                <td>@(log.DetectedBy ?? "Rule-based")</td>
                <td style="font-weight:bold;">
                    @if (log.Probability.HasValue)
                    {
                        <span style="color:@(log.Probability.Value > 0.7 ? "red" : "orange")">
                            @(log.Probability.Value.ToString("P2"))
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    @if (log.IsBlocked)
                    {
                        <span class="label label-danger">ĐÃ CHẶN</span>
                    }
                    else
                    {
                        <span class="label label-success">Cho qua</span>
                    }
                </td>
                <td>
                    @using (Html.BeginForm("Delete", "SQLInjectionLog", new { id = log.Id }, FormMethod.Post, new { @class = "inline-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-xs"
                                onclick="return confirm('Xóa log này?');">
                            🗑 Xóa
                        </button>
                    }
                    &nbsp;
                    <button type="button" class="btn btn-info btn-xs"
                            onclick="showDetail('@(log.SuspiciousInput.Replace("'", "\\'").Replace("\r", "\\r").Replace("\n", "\\n"))')">
                        👁 Chi tiết
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal xem chi tiết log -->
<div class="modal fade" id="detailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Chi tiết Payload</h4>
            </div>
            <div class="modal-body">
                <pre id="fullPayload" style="background:#f8f8f8; padding:15px; font-family:Consolas; white-space:pre-wrap; max-height:400px; overflow:auto;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<p><a href="@Url.Action("Index", "Home")" class="btn btn-primary">← Quay lại Trang chủ</a></p>

<script>
    function showDetail(payload) {
        document.getElementById('fullPayload').textContent = payload;
        $('#detailModal').modal('show');
    }
</script>