@model IEnumerable<eParty.Models.SQLInjectionLog>

@{
    ViewBag.Title = "SQL Injection Logs";
}

<h2>🔍 SQL Injection Detection Logs</h2>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Thời gian</th>
            <th>IP Address</th>
            <th>URL</th>
            <th>Payload</th>
            <th>Controller/Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td><strong>@log.IpAddress</strong></td>
                <td>@log.Url</td>
                <td style="color:red; font-family:monospace;">@log.SuspiciousInput</td>
                <td>@log.Controller / @log.Action</td>
            </tr>
        }
    </tbody>
</table>

<p><a href="@Url.Action("Index", "Home")" class="btn btn-primary">← Quay lại Trang chủ</a></p>